# Environment for deploy/aether.service (install as /etc/aether.env, mode 600).
# Every AETHER_* setting here wins over aether-server.toml.

# AETHER_DATABASE_URL=host=localhost user=aether password=change-me dbname=aether
# AETHER_HOST=0.0.0.0
# AETHER_PORT=25565
# AETHER_WORLD_DIR=/opt/aether/world
# AETHER_CACHE_DIR=/opt/aether/world-cache
# The directory that holds data/minecraft/ (tools/fetch-vanilla-data.sh prints it).
# AETHER_WORLDGEN_DATA=/opt/aether/vanilla/1.21.11
# Operators bound to the address they connect from (offline mode: a bare name
# is a claim anyone can make).
# AETHER_OPERATORS=_alpha_01@203.0.113.7
# AETHER_WHITELIST=_alpha_01,friend
